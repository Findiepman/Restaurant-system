{
  "compilerOptions": {
    "target": "ESNext",      /* Use modern JS features */
    "module": "ESNext",      /* Use standard browser modules (import/export) */
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node" /* Helps TS find your files correctly */
  },
  "include": ["src"]
}